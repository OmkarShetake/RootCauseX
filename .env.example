# ==============================================================================
# RootCauseX Production Environment Variables
# Copy this file to .env before deploying: cp .env.example .env
# ==============================================================================

# Database Configuration
POSTGRES_DB=rootcausex
POSTGRES_USER=rootcausex
POSTGRES_PASSWORD=your_super_secret_db_password_2026

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# GitHub Integration
# Set a personal access token to unlock 5,000 req/hr rate limits
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# AI Model Configuration (Google Gemini)
# Get your free API key from Google AI Studio: https://aistudio.google.com/
AI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Set to "false" to use live Gemini AI, or "true"/"auto" for offline testing
AI_MOCK_MODE=false

# GitHub Webhook (for real-time auto-triage on new issues)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Alert Notifications (all optional — omit to use log-only mode)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_RECIPIENT_EMAIL=team@yourcompany.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=alerts@yourcompany.com
MAIL_PASSWORD=your_app_password
